# Oturum çerezlerini imzalamak için kullanılan uzun ve rastgele bir metin.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Veritabanı ilk kez oluşturulurken eklenecek yönetici hesabı (opsiyonel, varsayılanlar kullanılabilir).
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# Turso (hosted libSQL) bağlantı bilgileri. Prod'da (Vercel) zorunlu.
# Boş bırakılırsa yerel geliştirmede otomatik olarak ./data/app.db dosyası kullanılır.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
